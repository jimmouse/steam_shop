# ── 数据库 ──
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/steam_store"

# ── 会话 ──
# 随机长字符串，用于签名登录 cookie。生产环境务必更换。
SESSION_SECRET="dev-only-change-me-please-use-a-long-random-string"

# ── 站点 ──
APP_URL="http://localhost:3000"
APP_NAME="Steam Store"

# ── 管理员 ──
# 这些邮箱注册时自动成为管理员，逗号分隔
ADMIN_EMAILS="admin@example.com"
# 后台通知渠道：邮件与 Telegram 各自独立，留空即不发
ADMIN_NOTIFY_EMAIL="admin@example.com"
# 接收后台通知的 Telegram chat id（逗号分隔多个）。在 Bot 里发 /id 查看自己的 chat id
ADMIN_TELEGRAM_CHAT_IDS=""

# ── 邮件 (SMTP)。留空则只在控制台打印邮件内容 ──
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Steam Store <no-reply@example.com>"

# ── Telegram Login Widget ──
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Webhook 模式下校验 Telegram 回传的 secret token（随机字符串，可留空）；长轮询模式不需要
TELEGRAM_WEBHOOK_SECRET=""

# ── 支付 ──
# 模拟支付商回调签名密钥
MOCK_PAYMENT_SECRET="mock-secret"

# 订单未支付自动过期（分钟）
ORDER_EXPIRE_MINUTES="15"

# ── BEpusdt 网关（https://github.com/v03413/BEpusdt，多链 USDT / USDC / 原生币，纯监听，不接支付宝 / 微信）──
# 留空则前台没有可用支付方式（仅开发环境可用「模拟支付」）
BEPUSDT_GATEWAY="https://pay.example.com"
# 后台「系统设置 → 对接令牌」
BEPUSDT_TOKEN=""
# 前台可选的链（逗号分隔，默认 8 种）。每种都要在 BEpusdt 后台「钱包」里配好对应的收款地址，否则建单失败
# 可选值见 src/server/lib/bepusdt.ts BEPUSDT_TRADE_TYPES
BEPUSDT_TRADE_TYPES="usdt.trc20,usdt.bep20,usdt.polygon,usdt.erc20,usdt.ton,usdt.solana,usdc.trc20,tron.trx"
# 回调基址，默认用 APP_URL。本地联调 BEpusdt 跑在 Docker 时设为 http://host.docker.internal:3000
# PAYMENT_NOTIFY_BASE_URL=""
